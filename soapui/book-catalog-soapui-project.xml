            <con:assertion type="GroovyScriptAssertion" id="385a8ed0-93df-5d9c-bc39-07359257923b" name="List contains created book">
              <con:configuration>
                <scriptText>import groovy.json.JsonSlurper

// Script assertions are handy when a check doesn't fit a single JsonPath expression
def books = new JsonSlurper().parseText(messageExchange.responseContent)
def id = context.expand('${#TestCase#bookId}') as long

assert books instanceof List
assert books.any { it.id == id } : "Created book $id not found in list"
</scriptText>

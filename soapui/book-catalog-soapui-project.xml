            <con:endpoint>${#Project#baseUrl}</con:endpoint>
            <con:request><![CDATA[{
  "title": "${#TestCase#title}",
  "author": "Ursula K. Le Guin",
  "isbn": "9780441478125",
  "publishedYear": 1969
}]]></con:request>
